# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Generate each secret with:
#   openssl rand -base64 32
#
# .env is gitignored. Never commit real credentials.

POSTGRES_DB=cbback
POSTGRES_USER=cbback
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-32
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-me-with-openssl-rand-base64-32
REDIS_PORT=6379

# --- API server -----------------------------------------------------------
# Used when running the server directly (go run ./cmd/server). The api compose
# service builds its own values from the credentials above.

DATABASE_URL=postgres://cbback:replace-me-with-openssl-rand-base64-32@127.0.0.1:5432/cbback?sslmode=disable
REDIS_URL=redis://:replace-me-with-openssl-rand-base64-32@127.0.0.1:6379/0

# The test suite writes real users and rooms. It points at a separate database
# and a separate Redis index so it never fills the development room directory.
TEST_DATABASE_URL=postgres://cbback:replace-me-with-openssl-rand-base64-32@127.0.0.1:5432/cbback_test?sslmode=disable
TEST_REDIS_URL=redis://:replace-me-with-openssl-rand-base64-32@127.0.0.1:6379/1

ADDR=:8080
LOG_LEVEL=info

# Sliding inactivity window: a user who visits at least this often stays signed
# in. The absolute lifetime (SESSION_ABSOLUTE_TTL, 720h) never slides, so a
# stolen session still expires.
SESSION_IDLE_TTL=168h

# Comma-separated browser origins allowed to call the API and open websockets.
# Empty means same-host only. "*" disables the check entirely — never in production.
ALLOWED_ORIGINS=http://localhost:5173

# false only for local http development. Must be true in production, or the
# session cookie will travel over plaintext.
COOKIE_SECURE=false

# Enable only when running behind a proxy that overwrites X-Forwarded-For.
# Enabling it without such a proxy lets callers spoof their IP past rate limits.
TRUST_PROXY=false

# --- TURN relay (coturn) ----------------------------------------------------
# Phones on mobile data sit behind carrier-grade NAT, so calls need a relay.
# Leave TURN_SECRET and TURN_URLS both empty to disable /api/turn-credentials
# (fine for local development on one network).
#
# TURN_SECRET is shared with coturn; generate it like the secrets above.
# TURN_PUBLIC_IP is the VPS's public IPv4, advertised in relay candidates.
TURN_SECRET=
TURN_REALM=cb-back
TURN_PUBLIC_IP=
# ICE server URLs handed to clients, comma-separated, e.g.
# turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
TURN_URLS=
# coturn rejects refreshes after expiry, so a relayed call cannot outlast this.
TURN_CREDENTIAL_TTL=24h
